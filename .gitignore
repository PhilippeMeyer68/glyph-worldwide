# ignore compiled file
__pycache__/
*.pyc
**/__pycache__/

# ignore egg-info
*.egg-info

# data, models and outputs (data and models are archived on Zenodo)
/data/
/models/
/results/

# ignore old files
**/old/

# run logs and local archives
/logs/
/_archive_non_regenerable/

# exploratory notebooks (not part of the pipeline)
/notebooks/
**/.ipynb_checkpoints/

# crash dumps
*.stackdump